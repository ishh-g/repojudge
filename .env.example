# Environment variables RepoJudge reads. Copy this file to `.env` and fill it in.
# Never commit your real .env file.

# Google Gemini API key. RepoJudge calls Gemma through the Gemini API.
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional GitHub personal access token. Raises the REST API rate limit from
# 60 to 5000 requests per hour. A token with no scopes is enough for public repos.
# Get one at https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional overrides (defaults shown).
# GEMMA_MODEL=gemma-4-26b-a4b-it
# GEMMA_TIMEOUT_SECONDS=300
# GEMMA_MAX_OUTPUT_TOKENS=2048
# GEMMA_TEMPERATURE=0.3
# The claims call runs cold so the same repo gives the same claims every time.
# GEMMA_CLAIMS_TEMPERATURE=0.0
# GEMMA_TOP_K=40
# GEMMA_TOP_P=0.95
# GEMMA_THINKING_LEVEL=low
# REPOJUDGE_CACHE_DIR=./cache
# Total source bytes read per repository, and bytes kept from any one big file
# (the lines that match a claim keyword are fetched back afterwards).
# REPOJUDGE_MAX_TOTAL_FILE_BYTES=307200
# REPOJUDGE_MAX_SINGLE_FILE_BYTES=65536
