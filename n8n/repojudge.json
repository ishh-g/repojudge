      "id": "2b2b2b2b-2222-4b2b-8b2b-bbbbbbbbbbbb",
      "name": "Analyze repo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [0, 0],
      "notesInFlow": true,
      "notes": "Calls the RepoJudge API. Change the URL if your RepoJudge runs elsewhere."
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Format a short summary: score, top 3 Verified, top 3 Unverified.\nconst report = $input.first().json;\n\nif (report.error) {\n  return [{ json: { message: 'RepoJudge error: ' + report.error.message, report } }];\n}\n\nconst claims = report.claims || [];\nconst pick = (status) => claims\n  .filter((c) => c.status === status)\n  .slice(0, 3)\n  .map((c) => '- ' + c.claim)\n  .join('\\n');\n\nconst verified = pick('Verified') || '- (none)';\nconst unverified = pick('Unverified') || '- (none)';\n\nconst lines = [\n  'RepoJudge: ' + report.repo.full_name,\n  'Score: ' + report.score.total + '/100 (grade ' + report.score.grade + ')',\n  'Analysis: ' + report.analysis_type,\n  '',\n  'Top verified claims:',\n  verified,\n  '',\n  'Top unverified claims:',\n  unverified,\n  '',\n  'Report: ' + report.repo.url,\n];\n\nreturn [{ json: { message: lines.join('\\n'), report } }];"
      },
      "id": "3c3c3c3c-3333-4c3c-8c3c-cccccccccccc",
      "name": "Format summary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [220, 0]
    },
